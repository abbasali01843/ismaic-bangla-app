<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup + device-transfer rules (API 31+).
  Because <include> elements are present, ONLY the listed paths are included.
  User data (bookmarks, notes, prayer log, reading progress, settings) is
  preserved; bulky re-downloadable audio and caches are left out.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Room database: bookmarks, notes, prayer log, last-read, cache. -->
        <include domain="database" path="islamic_database" />
        <include domain="database" path="islamic_database-wal" />
        <include domain="database" path="islamic_database-shm" />
        <include domain="database" path="islamic_database-journal" />
        <!-- DataStore preferences. -->
        <include domain="file" path="datastore/" />
        <!-- Downloaded audio is disposable; excluded explicitly for clarity. -->
        <exclude domain="file" path="audio/" />
        <exclude domain="file" path="azan.ogg" />
    </cloud-backup>
    <device-transfer>
        <!-- Same policy for direct device-to-device transfers. -->
        <include domain="database" path="islamic_database" />
        <include domain="database" path="islamic_database-wal" />
        <include domain="database" path="islamic_database-shm" />
        <include domain="database" path="islamic_database-journal" />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="audio/" />
        <exclude domain="file" path="azan.ogg" />
    </device-transfer>
</data-extraction-rules>
